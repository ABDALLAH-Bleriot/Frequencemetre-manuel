<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen"
    android:keepScreenOn="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:layout_marginTop="24dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card_glass"
        android:elevation="12dp"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <EditText
            android:id="@+id/etFreq"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="20"
            android:hint="20"
            android:inputType="number"
            android:maxLength="3"
            android:gravity="center"
            android:background="@null"
            android:textColor="@color/blue_gradient_end"
            android:textColorHint="@color/blue_gradient_end"
            android:textSize="56sp"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_semibold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ÉVÉNEMENTS /min"
            android:textSize="14sp"
            android:letterSpacing="0.15"
            android:fontFamily="@font/poppins"
            android:textColor="@color/text_gray" />

        <View
            android:layout_width="180dp"
            android:layout_height="2dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@color/blue_gradient_end" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_clock"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvChrono"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00.0"
                android:textSize="30sp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/text_white" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEvents"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 événements"
            android:textSize="13sp"
            android:fontFamily="@font/poppins"
            android:textColor="@color/text_dim"
            android:paddingTop="6dp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/track"
        android:layout_width="match_parent"
        android:layout_height="18dp"
        android:layout_marginLeft="24dp"
        android:layout_marginRight="24dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_band_off">

        <View
            android:id="@+id/thumb"
            android:layout_width="28dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@drawable/bg_thumb" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="44dp">

        <ImageButton
            android:id="@+id/btnPlay"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:src="@drawable/btn_play"
            android:scaleType="fitCenter"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Démarrer" />

        <ImageButton
            android:id="@+id/btnStop"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginStart="48dp"
            android:src="@drawable/btn_stop"
            android:scaleType="fitCenter"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Arrêter" />
    </LinearLayout>

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <include
        layout="@layout/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>

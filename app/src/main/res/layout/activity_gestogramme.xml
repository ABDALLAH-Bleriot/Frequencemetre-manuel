<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card_glass"
        android:layout_margin="16dp"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="Retour"
                android:layout_marginEnd="12dp" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Gestogramme"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/text_white" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤰"
            android:textSize="36sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp" />

        <View
            android:layout_width="120dp"
            android:layout_height="2dp"
            android:background="@color/blue_gradient_end"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Date :"
                android:textSize="15sp"
                android:fontFamily="@font/poppins"
                android:textColor="@color/text_gray" />
            <EditText
                android:id="@+id/etDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:hint="jj/mm/aaaa"
                android:inputType="date"
                android:gravity="center"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_dim"
                android:textSize="15sp" />
            <Button
                android:id="@+id/btnCalendar"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="10dp"
                android:text="Calendrier"
                android:textSize="13sp"
                android:textColor="#C7C9E4"
                android:fontFamily="@font/poppins"
                android:background="@drawable/bg_chip_unselected"
                android:paddingLeft="12dp"
                android:paddingRight="12dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="(Format : jj/mm/aaaa ou aaaa-mm-jj)"
            android:textSize="11sp"
            android:fontFamily="@font/poppins"
            android:textColor="@color/text_dim"
            android:gravity="center"
            android:layout_marginTop="4dp" />

        <RadioGroup
            android:id="@+id/rgMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="12dp">

            <RadioButton
                android:id="@+id/rbRegles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Date du premier jour des dernières règles"
                android:textSize="14sp"
                android:fontFamily="@font/poppins"
                android:textColor="@color/text_white"
                android:buttonTint="@color/blue_gradient_end"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbConception"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Date de conception"
                android:textSize="14sp"
                android:fontFamily="@font/poppins"
                android:textColor="@color/text_white"
                android:buttonTint="@color/blue_gradient_end" />

            <RadioButton
                android:id="@+id/rbTerme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Date du terme théorique"
                android:textSize="14sp"
                android:fontFamily="@font/poppins"
                android:textColor="@color/text_white"
                android:buttonTint="@color/blue_gradient_end" />

            <RadioButton
                android:id="@+id/rbEcho"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Date échographie, datation :"
                android:textSize="14sp"
                android:fontFamily="@font/poppins"
                android:textColor="@color/text_white"
                android:buttonTint="@color/blue_gradient_end" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginStart="28dp"
            android:layout_marginTop="4dp">
            <EditText
                android:id="@+id/etEchoSA"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="10dp"
                android:hint="SA"
                android:inputType="number"
                android:gravity="center"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_dim"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" S.A. + "
                android:textSize="14sp"
                android:fontFamily="@font/poppins"
                android:textColor="@color/text_gray" />
            <EditText
                android:id="@+id/etEchoJ"
                android:layout_width="60dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="10dp"
                android:hint="J"
                android:inputType="number"
                android:gravity="center"
                android:textColor="@color/text_white"
                android:textColorHint="@color/text_dim"
                android:textSize="14sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" J."
                android:textSize="14sp"
                android:fontFamily="@font/poppins"
                android:textColor="@color/text_gray" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" android:layout_marginTop="18dp" android:layout_marginBottom="18dp" />

        <Button
            android:id="@+id/btnCalculerGesto"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="Calculer"
            android:textColor="@color/text_white"
            android:textStyle="bold"
            android:fontFamily="@font/poppins_semibold"
            android:background="@drawable/bg_button_gradient" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" android:layout_marginTop="18dp" android:layout_marginBottom="14dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Résultats :" android:textSize="19sp" android:textStyle="bold" android:fontFamily="@font/poppins_semibold" android:textColor="@color/text_white" android:layout_marginBottom="8dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Premier jour dernières règles :" android:textSize="14sp" android:fontFamily="@font/poppins" android:textColor="@color/text_gray" />
            <TextView android:id="@+id/tvRegles" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="14sp" android:textStyle="bold" android:fontFamily="@font/poppins_semibold" android:textColor="@color/blue_gradient_end" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Date conception :" android:textSize="14sp" android:fontFamily="@font/poppins" android:textColor="@color/text_gray" />
            <TextView android:id="@+id/tvConception" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="14sp" android:textStyle="bold" android:fontFamily="@font/poppins_semibold" android:textColor="@color/blue_gradient_end" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Terme théorique :" android:textSize="14sp" android:fontFamily="@font/poppins" android:textColor="@color/text_gray" />
            <TextView android:id="@+id/tvTerme" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="14sp" android:textStyle="bold" android:fontFamily="@font/poppins_semibold" android:textColor="@color/blue_gradient_end" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Terme actuel :" android:textSize="14sp" android:fontFamily="@font/poppins" android:textColor="@color/text_gray" />
            <TextView android:id="@+id/tvTermeActuel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="14sp" android:textStyle="bold" android:fontFamily="@font/poppins_semibold" android:textColor="@color/blue_gradient_end" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Post terme (42 SA) :" android:textSize="14sp" android:fontFamily="@font/poppins" android:textColor="@color/text_gray" />
            <TextView android:id="@+id/tvPostTerme" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="14sp" android:textStyle="bold" android:fontFamily="@font/poppins_semibold" android:textColor="@color/blue_gradient_end" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="- Echographies -" android:textSize="16sp" android:textStyle="bold" android:fontFamily="@font/poppins_semibold" android:textColor="@color/text_white" android:gravity="center" android:layout_marginTop="16dp" android:layout_marginBottom="6dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="N°1 (11–13 SA+6) :" android:textSize="14sp" android:fontFamily="@font/poppins" android:textColor="@color/text_gray" />
            <TextView android:id="@+id/tvEcho1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="13sp" android:textStyle="bold" android:fontFamily="@font/poppins_semibold" android:textColor="@color/blue_gradient_end" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="N°2 (22–24 SA) :" android:textSize="14sp" android:fontFamily="@font/poppins" android:textColor="@color/text_gray" />
            <TextView android:id="@+id/tvEcho2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="13sp" android:textStyle="bold" android:fontFamily="@font/poppins_semibold" android:textColor="@color/blue_gradient_end" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="N°3 (32–34 SA) :" android:textSize="14sp" android:fontFamily="@font/poppins" android:textColor="@color/text_gray" />
            <TextView android:id="@+id/tvEcho3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="13sp" android:textStyle="bold" android:fontFamily="@font/poppins_semibold" android:textColor="@color/blue_gradient_end" />
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="- Dépistage trisomie 21 -" android:textSize="16sp" android:textStyle="bold" android:fontFamily="@font/poppins_semibold" android:textColor="@color/text_white" android:gravity="center" android:layout_marginTop="16dp" android:layout_marginBottom="6dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Du :" android:textSize="14sp" android:fontFamily="@font/poppins" android:textColor="@color/text_gray" />
            <TextView android:id="@+id/tvT21Du" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="14sp" android:textStyle="bold" android:fontFamily="@font/poppins_semibold" android:textColor="@color/blue_gradient_end" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="4dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Au (inclus) :" android:textSize="14sp" android:fontFamily="@font/poppins" android:textColor="@color/text_gray" />
            <TextView android:id="@+id/tvT21Au" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="14sp" android:textStyle="bold" android:fontFamily="@font/poppins_semibold" android:textColor="@color/blue_gradient_end" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/border" android:layout_marginTop="16dp" android:layout_marginBottom="12dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Interprétation :" android:textStyle="bold" android:textSize="14sp" android:fontFamily="@font/poppins_semibold" android:textColor="@color/text_white" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Le terme théorique correspond à 40 SA (280 jours après le 1er jour des dernières règles). Le dépassement de terme débute à 42 SA. La 1re échographie se réalise entre 11 SA et 13 SA+6, la 2e entre 22 SA et 24 SA, la 3e entre 32 SA et 34 SA. Le dépistage combiné de la trisomie 21 est conseillé entre 11 SA et 13 SA+6." android:textSize="12sp" android:fontFamily="@font/poppins" android:textColor="@color/text_dim" android:layout_marginTop="4dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Références :" android:textStyle="bold" android:textSize="14sp" android:fontFamily="@font/poppins_semibold" android:textColor="@color/text_white" android:layout_marginTop="12dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="J. Gynécologie Obstétrique et Biologie de la Reproduction, Vol. 40, Issue 8, Dec. 2011, p. 703-708, C. Le Ray, O. Anselem. HAS, recommandation en santé publique, dépistage de la trisomie 21, mars 2007." android:textSize="12sp" android:fontFamily="@font/poppins" android:textColor="@color/text_dim" android:layout_marginTop="4dp" />
    </LinearLayout>
</ScrollView>

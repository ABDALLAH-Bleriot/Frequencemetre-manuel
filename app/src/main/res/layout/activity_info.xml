<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_screen"
    android:keepScreenOn="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_glass"
            android:layout_margin="16dp"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fréquencemètre manuel"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Version 3.0 — 2026"
                android:gravity="center"
                android:textColor="@color/text_dim"
                android:paddingBottom="16dp" />

            <View
                android:layout_width="120dp"
                android:layout_height="2dp"
                android:background="@color/blue_gradient_end"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Principales fonctionnalités"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="L'application permet notamment de :"
                android:textSize="14sp"
                android:textColor="@color/text_gray"
                android:layout_marginBottom="10dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Compter manuellement une fréquence à l'aide d'appuis successifs sur l'écran.\n\nCalculer le débit d'une perfusion en gouttes par minute.\n\nCalculer la fréquence respiratoire en cycles par minute.\n\nCalculer la fréquence cardiaque en battements par minute.\n\nServir de repère rythmique lors de la réanimation cardio-pulmonaire (RCP).\n\nUtiliser un gestogramme pour faciliter le suivi et le calcul des dates importantes de la grossesse.\n\nUtiliser un générateur de fréquence avec signal visuel et sonore pour servir de référence lors du comptage."
                android:textSize="13sp"
                android:textColor="@color/text_gray"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Remarque : cette application est un outil d'aide au calcul et à l'apprentissage. Elle ne remplace pas le jugement clinique, les protocoles de soins ni les recommandations médicales en vigueur."
                android:textSize="12sp"
                android:textStyle="italic"
                android:textColor="@color/text_dim"
                android:lineSpacingExtra="2dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Informations sur l'auteur"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:layout_marginBottom="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dr ABDALLAH Andriamanantena Blériot\n\nSortant de la Faculté de Médecine de l'Université de Mahajanga\n\nN° matricule : 28001"
                android:textSize="13sp"
                android:textColor="@color/text_gray"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="16dp" />

            <!-- Téléphone -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📞 Téléphone (touchez pour appeler) :"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_gray" />

            <TextView
                android:id="@+id/tvPhone1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+261 34 99 820 80"
                android:textSize="15sp"
                android:textColor="@color/blue_gradient_end"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <TextView
                android:id="@+id/tvPhone2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+261 32 45 846 43"
                android:textSize="15sp"
                android:textColor="@color/blue_gradient_end"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <!-- Email -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📧 E-mail (touchez pour écrire) :"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_gray"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tvEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="dragonbleu47@gmail.com"
                android:textSize="15sp"
                android:textColor="@color/blue_gradient_end"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <!-- Facebook -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🌐 Facebook (touchez pour ouvrir) :"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_gray"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tvFacebook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="https://www.facebook.com/bleriot.abdallah"
                android:textSize="14sp"
                android:textColor="@color/blue_gradient_end"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />

            <!-- GitHub -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💻 GitHub (touchez pour ouvrir) :"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_gray"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tvGithub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="https://github.com/ABDALLAH-Bleriot/"
                android:textSize="14sp"
                android:textColor="@color/blue_gradient_end"
                android:paddingTop="6dp"
                android:paddingBottom="6dp" />
        </LinearLayout>
    </ScrollView>

    <include
        layout="@layout/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <ImageButton
        android:id="@+id/btnNavCounter"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:src="@drawable/nav_counter"
        android:scaleType="fitCenter"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Compteur" />

    <ImageButton
        android:id="@+id/btnNavGenerator"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:src="@drawable/nav_generator"
        android:scaleType="fitCenter"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Générateur" />

    <ImageButton
        android:id="@+id/btnNavCalc"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:src="@drawable/nav_calc"
        android:scaleType="fitCenter"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Calculs" />

    <ImageButton
        android:id="@+id/btnNavInfo"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_weight="1"
        android:src="@drawable/nav_info"
        android:scaleType="fitCenter"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="Info" />
</LinearLayout>
